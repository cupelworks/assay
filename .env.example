# Application
ASSAY_LOG_LEVEL=INFO
ASSAY_HOST=127.0.0.1
ASSAY_PORT=8000

# Database
# Local (default): SQLite via aiosqlite — no setup required, file created automatically
ASSAY_DATABASE_URL=sqlite+aiosqlite:///./assay.db
# Production: swap to PostgreSQL via asyncpg
# ASSAY_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/assay

# LLM provider selection (used by the LLM-as-judge evaluator)
ASSAY_LLM_PROVIDER=anthropic
ASSAY_LLM_MODEL=claude-sonnet-4-6

# LLM provider keys — fill in the one matching ASSAY_LLM_PROVIDER
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
