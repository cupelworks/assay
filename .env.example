# Application
# Both apply to the API, the worker and Beat.
# Level for the app's own loggers (assay.*); third-party ones stay at INFO.
# DEBUG additionally logs every SQL statement.
ASSAY_LOG_LEVEL=INFO
# text: readable lines for a terminal. json: one JSON object per line, for a
# log collector (Azure Monitor, Datadog, ...) — use json in production.
ASSAY_LOG_FORMAT=text
ASSAY_HOST=127.0.0.1
ASSAY_PORT=8000

# Database
# Local (default): SQLite via aiosqlite — no setup required, file created automatically
ASSAY_DATABASE_URL=sqlite+aiosqlite:///./assay.db
# Production: swap to PostgreSQL via asyncpg
# ASSAY_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/assay

# CORS — comma-separated list of allowed origins
ASSAY_CORS_ALLOWED_ORIGINS=http://localhost:4200

# LLM provider selection (used by the LLM-as-judge evaluator)
ASSAY_LLM_PROVIDER=anthropic
ASSAY_LLM_MODEL=claude-sonnet-4-6

# LLM provider keys — fill in the one matching ASSAY_LLM_PROVIDER
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Worker (Celery). The API reads these too now (it dispatches via a
# producer-only Celery client), not just the worker process (assay.worker).
# Running the worker process itself still requires the `worker` extra:
# uv sync --extra worker
# Local (default): a real Redis — brew install redis && brew services start
# redis on macOS (or docker run -p 6379:6379 redis). Free for local dev.
ASSAY_CELERY_BROKER_URL=redis://localhost:6379/0
ASSAY_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# assay/worker/db.py's sync engine pool — only read by the worker process.
# Size against whichever --pool the worker runs under: small under the
# default --pool=prefork (each forked child gets its own copy of this
# pool); against total --concurrency under --pool=threads/solo instead,
# since there's no forking and every task shares this one pool. See README
# Worker section for why --pool=threads may be needed at all.
ASSAY_WORKER_DB_POOL_SIZE=10
ASSAY_WORKER_DB_MAX_OVERFLOW=10

# Celery Beat reconciliation scan — only read by the worker/Beat processes.
# Beat publishes reconcile_runs every INTERVAL minutes; it re-publishes every
# Pending run older than THRESHOLD minutes (its original dispatch presumed lost).
# Run exactly one Beat process per environment: celery -A assay.worker beat
ASSAY_RECONCILIATION_INTERVAL_MINUTES=60
ASSAY_RECONCILIATION_PENDING_THRESHOLD_MINUTES=15
# Local, no separate service to install: SQLite-backed broker + result
# backend instead — same "zero setup" story as the database's own default
# ASSAY_CELERY_BROKER_URL=sqla+sqlite:///./celery_broker.sqlite
# ASSAY_CELERY_RESULT_BACKEND=db+sqlite:///./celery_results.sqlite
# Production: Azure Cache for Redis (or any TLS-only managed Redis) — use
# rediss://, not redis:// — port 6380, not 6379. The rediss:// scheme alone
# is enough; assay.worker.celery_app detects it and turns on certificate
# verification.
# ASSAY_CELERY_BROKER_URL=rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
# ASSAY_CELERY_RESULT_BACKEND=rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
